APP_NAME=MedIQ API
ENV=dev
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Durée de validité du lien de réinitialisation de mot de passe (minutes)
RESET_TOKEN_EXPIRE_MINUTES=30

# Ne pas modifier ces valeurs si vous utilisez Docker Compose
DATABASE_URL=postgresql+psycopg2://medicalvision:medicalvision@localhost:5432/medicalvision
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ──────────────────────────────────────────────
# Email / SMTP (envoi des e-mails : approbation/rejet de compte,
# réinitialisation de mot de passe). Si SMTP_USER ou SMTP_PASSWORD est vide,
# l'envoi est désactivé silencieusement (un warning est loggué).
# ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Compte expéditeur. Pour Gmail : adresse Google complète.
SMTP_USER=votre-compte@gmail.com
# ⚠️ Gmail : utiliser un MOT DE PASSE D'APPLICATION (16 caractères, 2FA requise),
# PAS le mot de passe Gmail normal. Voir https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-16-char-app-password
# Doit être identique à SMTP_USER pour Gmail
SMTP_FROM_EMAIL=votre-compte@gmail.com
SMTP_FROM_NAME=MedIQ

# Base d'URL du frontend — sert à construire le lien envoyé par e-mail
# (réinitialisation : {FRONTEND_URL}/reset-password?token=...). En prod, mettre l'URL publique.
# ⚠️ Doit correspondre au port réel du serveur Vite (vite.config.ts → server.port = 8080).
FRONTEND_URL=http://localhost:8080
